---
import { siteConfig } from '../config';
---

<section class="section cta-section" id="contact">
  <div class="container">
    
    <div class="cta-banner card-tactile reveal-on-scroll">
      <div class="cta-glow-bg" aria-hidden="true"></div>

      <div class="cta-inner">
        <div class="section-tag cta-tag">
          <span class="pulse-dot" aria-hidden="true"></span>
          <span>{siteConfig.cta.badge}</span>
        </div>

        <h2 class="cta-title">
          {siteConfig.cta.title}
        </h2>

        <p class="cta-subtitle">
          {siteConfig.cta.subtitle}
        </p>

        <div class="cta-actions">
          <a href={siteConfig.links.contactUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-cta-main">
            <span>{siteConfig.cta.buttonText}</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </a>
        </div>

        <div class="cta-trust-note mono">
          <span>ОТВЕЧАЕМ В ТЕЧЕНИЕ ДНЯ // БЕЗ СПАМА И БЮРОКРАТИИ</span>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .cta-section {
    padding-top: 4rem;
    padding-bottom: 6rem;
  }

  .cta-banner {
    background: rgba(11, 16, 26, 0.52);
    backdrop-filter: blur(36px) saturate(190%);
    -webkit-backdrop-filter: blur(36px) saturate(190%);
    border: 1px solid rgba(0, 242, 157, 0.35);
    border-radius: var(--radius-lg);
    position: relative;
    overflow: hidden;
    box-shadow: 
      inset 0 1px 1px rgba(255, 255, 255, 0.25),
      0 32px 70px -12px rgba(0, 0, 0, 0.75),
      0 0 50px -10px rgba(0, 242, 157, 0.2);
  }

  .cta-glow-bg {
    position: absolute;
    top: -50%;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 400px;
    background: radial-gradient(circle, rgba(0, 242, 157, 0.12) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-inner {
    padding: 3.5rem 2rem;
    text-align: center;
    max-width: 780px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  @media (min-width: 768px) {
    .cta-inner {
      padding: 5rem 3rem;
    }
  }

  .cta-tag {
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 1.5rem;
  }

  .cta-title {
    font-size: clamp(2.25rem, 5vw, 3.6rem);
    line-height: 1.12;
    margin-bottom: 1.25rem;
  }

  .cta-subtitle {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 2.5rem;
  }

  .cta-actions {
    display: flex;
    justify-content: center;
    margin-bottom: 2rem;
  }

  .btn-cta-main {
    padding: 1.15rem 2.5rem;
    font-size: 1.15rem;
  }

  .cta-trust-note {
    font-size: 0.75rem;
    color: var(--text-muted);
    letter-spacing: 0.08em;
  }
</style>
